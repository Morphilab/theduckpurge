# License: MIT

set -euo pipefail
IFS=$'\n\t'

# ============================= CONFIGURATION ================================
readonly VERSION="1.2.0"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly SCRIPT_NAME
MAX_FILE_SIZE=104857600  # 100 MB

LEVEL="standard"
BACKUP=false RENAME=false RECURSIVE=false QUIET=false ZERO_TRACE=false
CHECK_ONLY=false DRY_RUN=false FORCE=false NO_COLOR=false VERBOSE=false JSON=false
EXCLUDE_PATTERNS=() JOBS=0 INIT_MODE=false REPORT_MODE=false

# Counters (used across modes):
#   TOTAL           — all files evaluated
#   FAILED          — processing errors
#   SKIPPED         — excluded, unsupported format, too large, symlink
# Cleaning mode counters:
#   CLEANED         — file fully cleaned
#   REENCODED       — file was re-encoded (paranoid level only)
# Check‑only mode counters (mutually exclusive with above):
#   VERIFIED_CLEAN  — file had no metadata
#   VERIFIED_DIRTY  — file had metadata
# Dry‑run mode counter:
#   DRY_COUNT       — files that would be processed
# Backup counter (incremented per successful backup; avoids a find call in summary):
declare -i TOTAL=0 CLEANED=0 FAILED=0 SKIPPED=0 REENCODED=0
declare -i VERIFIED_CLEAN=0 VERIFIED_DIRTY=0
declare -i DRY_COUNT=0 BACKUP_COUNT=0 BATCH_TOTAL=0
# Permission-only failures (exit code 4 contract); subset of FAILED.
declare -i PERM_ERRORS=0
# Set by reencode_file(): "re-encoded" (true codec re-encode) or "remuxed"
# (stream-copy fallback — weaker guarantee, container metadata only).
REENCODE_MODE=""

TEMP_DIR=""
BACKUP_DIR=""
declare -a INPUT_PATHS=()

# ============================= COLORS & LOGGING =============================
init_colors() {
    if [[ -n "${NO_COLOR:-}" ]] || ! [[ -t 2 ]]; then
        COLOR_SUPPORT=false
        RED='' GREEN='' YELLOW='' RESET=''
    else
        COLOR_SUPPORT=true
        RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[0;33m' RESET='\033[0m'
    fi
}

log() {
    local level="$1" message="$2"
    [[ "$QUIET" == true && "$level" != "ERROR" && "$level" != "WARN" ]] && return 0

    local prefix="" color=""
    case "$level" in
        ERROR)   prefix="✗" color="$RED" ;;
        WARN)    prefix="⚠" color="$YELLOW" ;;
        SUCCESS) prefix="✓" color="$GREEN" ;;
        INFO)    prefix="•" ;;
        *)       prefix="•" ;;
    esac

    if [[ "$COLOR_SUPPORT" == true ]]; then
        printf "%b%s %s%b\n" "$color" "$prefix" "$message" "$RESET" >&2
    else
        printf "%s %s\n" "$prefix" "$message" >&2
    fi
}

# ============================= UTILITIES ====================================
command_exists() { command -v "$1" >/dev/null 2>&1; }

# Strip leading/trailing whitespace only (inner spaces are preserved).
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

verbose_log() {
    [[ "$VERBOSE" == true ]] && log INFO "$@"
}

# ============================= EXCLUSIONS ====================================
EXCLUDE_GREP_PATTERN=""

build_exclude_pattern() {
    local patterns=()
    local exclude_file

    # Auto-load .theduckpurge.exclude from current directory
    if [[ -f ".theduckpurge.exclude" ]]; then
        while IFS= read -r line; do
            line="$(trim "${line%%#*}")"
            [[ -n "$line" ]] && patterns+=("$line")
        done < ".theduckpurge.exclude"
    fi

    # Auto-load from home config
    exclude_file="${HOME}/.config/theduckpurge/exclude"
    if [[ -f "$exclude_file" ]]; then
        while IFS= read -r line; do
            line="$(trim "${line%%#*}")"
            [[ -n "$line" ]] && patterns+=("$line")
        done < "$exclude_file"
    fi

    for p in "${EXCLUDE_PATTERNS[@]}"; do
        patterns+=("$p")
    done

    # Fail closed on invalid ERE: silently ignoring an exclusion could cause
    # files the user wanted excluded to be processed.
    for p in "${patterns[@]}"; do
        local rc=0
        printf '\n' | grep -qE -- "$p" 2>/dev/null || rc=$?
        if [[ $rc -eq 2 ]]; then
            log ERROR "Invalid exclude pattern (ERE syntax): $p"
            exit 1
        fi
    done

    if [[ ${#patterns[@]} -gt 0 ]]; then
        local sep=""
        EXCLUDE_GREP_PATTERN=""
        for p in "${patterns[@]}"; do
            EXCLUDE_GREP_PATTERN="${EXCLUDE_GREP_PATTERN}${sep}${p}"
            sep="|"
        done
    fi
}

is_excluded() {
    local file="$1"
    local basename
    basename="$(basename "$file")"
    if [[ -n "$EXCLUDE_GREP_PATTERN" ]]; then
        # printf (not echo): a basename like "-n" would be parsed as an
        # echo flag, feeding grep empty input and silently skipping the
        # exclusion for that file.
        if printf '%s\n' "$basename" | grep -qE "$EXCLUDE_GREP_PATTERN" 2>/dev/null; then
            return 0
        fi
        if printf '%s\n' "$file" | grep -qE "$EXCLUDE_GREP_PATTERN" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# ============================= CONFIG FILE ===================================
load_config() {
    local config="$1"
    [[ ! -f "$config" ]] && { log WARN "Config file not found: $config"; return 1; }

    while IFS='=' read -r key value; do
        key="$(trim "${key%%#*}")"
        key="${key// /}"
        value="$(trim "$value")"
        [[ -z "$key" ]] && continue
        case "$key" in
            level)
                if [[ "$value" =~ ^(light|standard|aggressive|paranoid)$ ]]; then
                    LEVEL="$value"
                else
                    log ERROR "Invalid level in config: $value"
                    exit 1
                fi ;;
            backup)     [[ "$value" == "true" ]] && BACKUP=true ;;
            rename)     [[ "$value" == "true" ]] && RENAME=true ;;
            recursive)  [[ "$value" == "true" ]] && RECURSIVE=true ;;
            quiet)      [[ "$value" == "true" ]] && QUIET=true ;;
            verbose)    [[ "$value" == "true" ]] && VERBOSE=true ;;
            force)      [[ "$value" == "true" ]] && FORCE=true ;;
            no-color)   [[ "$value" == "true" ]] && NO_COLOR=true ;;
            jobs)       JOBS="$value"; log WARN "--jobs is accepted but not implemented yet; running sequentially" ;;
            max-file-size)
                if [[ "$value" =~ ^[0-9]+$ ]]; then
                    MAX_FILE_SIZE="$value"
                else
                    log WARN "Invalid max-file-size in config: $value"
                fi ;;
            exclude)    EXCLUDE_PATTERNS+=("$value") ;;
            *)          log WARN "Unknown config key: $key" ;;
        esac
    done < "$config"
}

# ============================= JSON REPORT ===================================
JSON_ITEMS=""

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

json_add_item() {
    local file="$1" status="$2" message="$3" metadata_count="${4:-0}"
    [[ "$JSON" != true ]] && return 0
    local item
    item=$(printf '{"file":"%s","status":"%s","message":"%s","metadata_count":%d}' \
        "$(json_escape "$file")" "$(json_escape "$status")" "$(json_escape "$message")" "$metadata_count")
    [[ -n "$JSON_ITEMS" ]] && JSON_ITEMS="${JSON_ITEMS},"
    JSON_ITEMS="${JSON_ITEMS}${item}"
}

json_output() {
    [[ "$JSON" != true ]] && return 0
    local total="${1:-0}" cleaned="${2:-0}" skipped="${3:-0}" failed="${4:-0}" extra=""
    if [[ "$CHECK_ONLY" == true ]]; then
        extra=",\"verified_clean\":$VERIFIED_CLEAN,\"verified_dirty\":$VERIFIED_DIRTY"
    elif [[ "$DRY_RUN" == true ]]; then
        extra=",\"simulated\":$DRY_COUNT"
    fi
    printf '{"version":"%s","summary":{"total":%d,"cleaned":%d,"skipped":%d,"failed":%d%s},"files":[%s]}\n' \
        "$VERSION" "$total" "$cleaned" "$skipped" "$failed" "$extra" "$JSON_ITEMS"
}

get_file_size() {
    local size=0
    if command_exists stat; then
        size="$(stat -c%s "$1" 2>/dev/null || echo 0)"
    fi
    if [[ $size -eq 0 ]]; then
        size="$(wc -c < "$1" 2>/dev/null || echo 0)"
    fi
    echo "$size"
}

get_extension() {
    local ext="${1##*.}"
    printf '%s' "${ext,,}"
}

is_supported_format() {
    local ext; ext="$(get_extension "$1")"
    case "$ext" in
        pdf|jpg|jpeg|png|gif|bmp|tiff|tif|heic|heif|webp|svg \
        |doc|docx|xls|xlsx|ppt|pptx|odt|ods|odp \
        |mp3|mp4|avi|mov|mkv|flac|wav|m4a|wmv)
            return 0 ;;
        *) return 1 ;;
    esac
}

check_file_safety() {
    local file="$1"
    if [[ -L "$file" ]]; then
        log ERROR "Symlink detected and rejected: $file"
        return 1
    fi
    if [[ ! -f "$file" ]]; then
        log ERROR "Not a regular file: $file"
        return 1
    fi
    if [[ ! -r "$file" ]]; then
        log ERROR "No read permission: $file"
        return 1
    fi
    return 0
}

check_dependencies() {
    local missing=() broken=()
    if command_exists mat2; then
        mat2 --help >/dev/null 2>&1 || broken+=("mat2 (unresponsive)")
    else
        missing+=("mat2")
    fi
    if command_exists exiftool; then
        exiftool -ver >/dev/null 2>&1 || broken+=("exiftool (unresponsive)")
    else
        missing+=("exiftool")
    fi
    if [[ ${#missing[@]} -gt 0 || ${#broken[@]} -gt 0 ]]; then
        log ERROR "Dependency issues:"
        [[ ${#missing[@]} -gt 0 ]] && log ERROR "  Missing: ${missing[*]}"
        [[ ${#broken[@]} -gt 0 ]] && log ERROR "  Unresponsive: ${broken[*]}"
        log INFO "Install with: sudo apt install mat2 libimage-exiftool-perl ffmpeg"
        exit 3
    fi

    # Paranoid level performs true re-encoding; without ffmpeg the level would
    # silently degrade. Fail honestly instead.
    if [[ "$LEVEL" == "paranoid" && "$CHECK_ONLY" != true && "$DRY_RUN" != true ]] \
        && ! command_exists ffmpeg; then
        log ERROR "Level 'paranoid' requires ffmpeg for true re-encoding."
        log INFO "Install with: sudo apt install ffmpeg"
        exit 3
    fi
}

# ============================= METADATA CHECKING ============================
# Technical fields that carry no privacy impact. Everything NOT listed here is
# counted as potential privacy metadata (fail-safe direction: over-reporting
# is preferable to missing GPS coordinates or dates).
# NOTE: multi-word names MUST be quoted here or each word becomes its own
# element and the anchored exclusion silently stops matching.
readonly TECHNICAL_FIELDS=(
    "File Name" "Directory" "File Size"
    "File Modification Date/Time" "File Access Date/Time" "File Inode Change Date/Time"
    "File Permissions" "File Type" "File Type Extension" "MIME Type"
    "Image Width" "Image Height" "Image Size" "Megapixels"
    "Encoding Process" "Color Components" "Y Cb Cr Sub Sampling"
    "JFIF Version" "Resolution Unit" "X Resolution" "Y Resolution"
    "Current IPTC Digest" "ExifTool Version Number"
    "Bits Per Sample" "Exif Byte Order" "Color Space"
    "Exif Version" "Components Configuration" "Flashpix Version" "Y Cb Cr Positioning"
    "Samples Per Pixel" "Photometric Interpretation" "Thumbnail Offset" "Thumbnail Length"
    "PDF Version" "Linearized" "Page Count" "Page Size"
    "Duration" "Bit Depth" "Channels" "Channel Mode" "Sample Rate"
    "Audio Bitrate" "Video Bitrate" "Frame Rate" "Avg Bitrate" "Codec ID" "Stream Size"
)
check_metadata() {
    local file="$1" count=0
    if command_exists exiftool; then
        # Anchored whitelist exclusion (supports multi-word field names);
        # every remaining "Field Name : value" line counts as privacy metadata.
        local exclude="" sep=""
        local field escaped
        for field in "${TECHNICAL_FIELDS[@]}" Warning; do
            escaped="$(printf '%s' "$field" | sed 's/[][\.*^$+?{|()]/\\&/g')"
            exclude="${exclude}${sep}^${escaped}[[:space:]]*:"
            sep="|"
        done
        count=$(exiftool -all -- "$file" 2>/dev/null | \
            grep -v -E "$exclude" | \
            grep -c -E '^[A-Za-z][^:]*:') || true
    fi
    echo "${count:-0}"
}

# ============================= REPORT ========================================
report_file() {
    local file="$1" filename ext size metadata_count
    filename="$(basename "$file")"
    ext="$(get_extension "$file")"
    size="$(get_file_size "$file")"
    metadata_count="$(check_metadata "$file")"

    local color_clean="" color_dirty="" color_reset=""
    if [[ "$COLOR_SUPPORT" == true ]]; then
        color_clean="$GREEN" color_dirty="$YELLOW" color_reset="$RESET"
    fi

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    printf "File: %s%s%s\n" "$color_clean" "$filename" "$color_reset"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Path:       $file"
    echo "  Extension:  .$ext"
    echo "  Size:       $size bytes"

    if [[ "$metadata_count" -eq 0 ]]; then
        printf "  Status:     %s✓ CLEAN%s (no privacy metadata)\n" "$color_clean" "$color_reset"
    else
        printf "  Status:     %s⚠ DIRTY%s (%d metadata fields found)\n" "$color_dirty" "$color_reset" "$metadata_count"
    fi

    if command_exists exiftool; then
        echo ""
        echo "  Metadata details:"
        local field name value
        while IFS= read -r line; do
            # Trim BOTH sides: exiftool pads field names with trailing spaces
            # and a leading-only trim made every field classify as [privacy].
            name="$(echo "$line" | cut -d: -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            value="$(echo "$line" | cut -d: -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            # Classify against the technical whitelist (fail-safe: unlisted
            # fields are reported as privacy metadata).
            local is_technical=false
            for field in "${TECHNICAL_FIELDS[@]}"; do
                if [[ "$name" == "$field" ]]; then
                    is_technical=true
                    break
                fi
            done
            if [[ "$is_technical" == true ]]; then
                printf "    %s [technical]: %s\n" "$name" "$value"
            else
                printf "    %s%s [privacy]%s: %s\n" "$color_dirty" "$name" "$color_reset" "$value"
            fi
        done < <(exiftool -all -- "$file" 2>/dev/null | grep -E '^[A-Za-z]' || true)
    fi
    echo ""
}

# ============================= CLEANING =====================================
# Strategy: run mat2 --inplace on a file, then move result to output.
# Flags ($@) must come before positional argument "$src".
_mat2_inplace() {
    local src="$1" dst="$2"
    shift 2
    mat2 "$@" --inplace "$src" >/dev/null 2>&1 && mv "$src" "$dst" 2>/dev/null
}

# Strategy: run mat2 (non-inplace) and locate the .cleaned output.
# Flags ($@) must come before positional argument "$src".
_mat2_output() {
    local src="$1" dst="$2" base ext candidate
    shift 2
    mat2 "$@" "$src" >/dev/null 2>&1 || return 1
    base="${src%.*}"
    ext="${src##*.}"
    candidate="${base}.cleaned.${ext}"
    if [[ -f "$candidate" ]]; then
        mv "$candidate" "$dst" 2>/dev/null && return 0
    fi
    return 1
}

clean_with_mat2() {
    local input="$1" output="$2"
    local mat2_opts=()
    [[ "$LEVEL" == "light" ]] && mat2_opts+=(--light)

    # Dedicated work directory so strategies never corrupt $input.
    local work_dir copy_in
    work_dir="$(mktemp -d --tmpdir="${TEMP_DIR}" "mat2_work_XXXXXX")" || return 1
    copy_in="${work_dir}/$(basename "$input")"
    cp -p "$input" "$copy_in" 2>/dev/null || { rm -rf "$work_dir"; return 1; }

    # Try inplace first (fastest), fall back to non-inplace with .cleaned.
    if _mat2_inplace "$copy_in" "$output" "${mat2_opts[@]}" \
        || _mat2_output "$copy_in" "$output" "${mat2_opts[@]}"; then
        rm -rf "$work_dir"
        return 0
    fi

    rm -rf "$work_dir"
    return 1
}

clean_with_exiftool() {
    local file="$1"
    exiftool -overwrite_original -all= -- "$file" >/dev/null 2>&1 || {
        log WARN "exiftool failed to clean: $(basename "$file")"
        return 1
    }
}

# True re-encode per media type: metadata is stripped at container level
# (-map_metadata -1) AND the streams are re-encoded, so codec-embedded data
# does not survive. If the target encoder is unavailable (or the format
# cannot be decoded), falls back to a remux (-c copy) and sets REENCODE_MODE
# to "remuxed" so the caller can warn about the weaker guarantee.
reencode_file() {
    REENCODE_MODE=""
    command_exists ffmpeg || return 1
    local input="$1" output="$2" ext
    ext="$(get_extension "$input")"
    local opts=(-map_metadata -1)
    case "$ext" in
        mp4|mov|mkv|avi|wmv)
            opts+=(-map_chapters -1 -c:v libx264 -preset veryfast -c:a aac) ;;
        mp3)  opts+=(-c:a libmp3lame) ;;
        m4a)  opts+=(-c:a aac) ;;
        flac) opts+=(-c:a flac) ;;
        wav)  opts+=(-c:a pcm_s16le) ;;
        *)    opts=() ;;   # images/docs: default decoder+encoder = true re-encode
    esac
    if ffmpeg -y -i "$input" "${opts[@]}" "$output" >/dev/null 2>&1 && [[ -f "$output" ]]; then
        REENCODE_MODE="re-encoded"
        return 0
    fi
    if ffmpeg -y -i "$input" -map_metadata -1 -map_chapters -1 -c copy "$output" >/dev/null 2>&1 && [[ -f "$output" ]]; then
        REENCODE_MODE="remuxed"
        return 0
    fi
    return 1
}

clean_file() {
    local original="$1" filename ext temp clean
    filename="$(basename "$original")"
    ext="${original##*.}"

    temp="$(mktemp --tmpdir="${TEMP_DIR}" "tmp_XXXXXX.${ext}")" || {
        log ERROR "Could not create temp file: $filename"; return 1
    }
    clean="$(mktemp --tmpdir="${TEMP_DIR}" "clean_XXXXXX.${ext}")" || {
        rm -f "$temp" 2>/dev/null
        log ERROR "Could not create temp file: $filename"; return 1
    }

    cp -p "$original" "$temp" || { log ERROR "Could not create working copy: $filename"; return 1; }

    if [[ "$BACKUP" == true ]] && [[ -n "$BACKUP_DIR" ]]; then
        if cp -p "$original" "${BACKUP_DIR}/${filename}_$$_$(date +%s%N)" 2>/dev/null; then
            (( ++BACKUP_COUNT ))
        else
            log WARN "Could not create backup for: $filename"
        fi
    fi

    local result=0
    case "$LEVEL" in
        light|standard)
            clean_with_mat2 "$temp" "$clean" || result=1
            ;;
        aggressive)
            clean_with_mat2 "$temp" "$clean" && clean_with_exiftool "$clean" || result=1
            ;;
        paranoid)
            if clean_with_mat2 "$temp" "$clean"; then
                clean_with_exiftool "$clean"
                local reencoded
                reencoded="$(mktemp --tmpdir="${TEMP_DIR}" "re_XXXXXX.${ext}")" || {
                    log WARN "Could not create file for re-encoding: $filename"
                }
                if [[ -n "$reencoded" ]] && reencode_file "$clean" "$reencoded"; then
                    mv "$reencoded" "$clean"
                    (( ++REENCODED ))
                    if [[ "$REENCODE_MODE" == "remuxed" ]]; then
                        log WARN "True re-encode unavailable for this format; used remux fallback: $filename"
                    fi
                elif [[ -n "$reencoded" ]]; then
                    log WARN "Re-encoding failed (ffmpeg may not support this format): $filename"
                fi
            else
                result=1
            fi
            ;;
        *)
            log ERROR "Unknown cleaning level: $LEVEL"
            result=1
            ;;
    esac

    if [[ $result -eq 0 ]]; then
        if [[ -f "$clean" ]]; then
            # Preserve the original file mode across all levels; the paranoid
            # re-encode output is a fresh mktemp (0600) and would otherwise
            # silently downgrade permissive modes.
            chmod --reference="$original" "$clean" 2>/dev/null || true
            mv "$clean" "$original" || { log ERROR "Could not replace: $filename"; result=1; }
            if [[ $result -eq 0 ]]; then
                local remaining; remaining="$(check_metadata "$original")"
                if [[ "$remaining" -gt 0 ]]; then
                    log WARN "Partially cleaned: $filename ($remaining metadata remain)"
                fi
            fi
        else
            log ERROR "No cleaned file produced: $filename"
            result=1
        fi
    fi

    rm -f "$temp" "$clean" 2>/dev/null || true
    return $result
}

# ============================= PROCESSING ===================================
process_single_file() {
    local file="$1" filename; filename="$(basename "$file")"

    check_file_safety "$file" || {
        if [[ -e "$file" && ! -r "$file" ]]; then
            (( ++PERM_ERRORS ))
        fi
        (( ++FAILED ))
        return 1
    }

    (( ++TOTAL ))

    if is_excluded "$file"; then
        log INFO "Excluded: $filename"
        (( ++SKIPPED ))
        return 0
    fi

    if [[ "$(get_file_size "$file")" -gt $MAX_FILE_SIZE ]] && [[ "$FORCE" != true ]]; then
        log WARN "File too large: $filename"
        json_add_item "$filename" "skipped" "file too large"
        (( ++SKIPPED ))
        return 0
    fi

    if ! is_supported_format "$file"; then
        log WARN "Unsupported format: $filename"
        json_add_item "$filename" "skipped" "unsupported format"
        (( ++SKIPPED ))
        return 0
    fi

    if [[ "$CHECK_ONLY" == true ]]; then
        if [[ "$REPORT_MODE" == true ]]; then
            report_file "$file"
            return 0
        fi
        local count; count="$(check_metadata "$file")"
        if [[ "$count" -le 0 ]]; then
            log SUCCESS "Already clean: $filename"
            json_add_item "$filename" "clean" "no metadata" 0
            (( ++VERIFIED_CLEAN ))
        else
            log WARN "Contains $count metadata: $filename"
            json_add_item "$filename" "dirty" "metadata found" "$count"
            (( ++VERIFIED_DIRTY ))
        fi
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        local prefix=""
        [[ $BATCH_TOTAL -gt 0 ]] && prefix="[$TOTAL/$BATCH_TOTAL] "
        log INFO "${prefix}[DRY RUN] Would process: $filename (level: $LEVEL)"
        json_add_item "$filename" "dry-run" "would process"
        (( ++DRY_COUNT ))
        return 0
    fi

    if [[ $BATCH_TOTAL -gt 0 ]]; then
        log INFO "[$TOTAL/$BATCH_TOTAL] Processing: $filename (level: $LEVEL)"
    else
        log INFO "Processing: $filename (level: $LEVEL)"
    fi

    if clean_file "$file"; then
        if [[ "$RENAME" == true ]]; then
            local new_name
            new_name="$(dirname "$file")/clean_$(date +%s)_$filename"
            if mv "$file" "$new_name" 2>/dev/null; then
                log SUCCESS "Cleaned and renamed: $filename → $(basename "$new_name")"
                json_add_item "$filename" "cleaned" "renamed to $(basename "$new_name")"
            else
                log SUCCESS "Cleaned (rename failed): $filename"
                json_add_item "$filename" "cleaned" "rename failed"
            fi
        else
            log SUCCESS "Cleaned: $filename"
            json_add_item "$filename" "cleaned" "ok"
        fi
        (( ++CLEANED ))
    else
        log ERROR "Failed to clean: $filename"
        json_add_item "$filename" "failed" "cleaning error"
        (( ++FAILED ))
    fi
    return 0
}

process_directory() {
    local dir="$1"
    [[ ! -d "$dir" || ! -r "$dir" ]] && { log ERROR "Directory not accessible: $dir"; return 1; }

    log INFO "Processing directory: $dir"

    local find_opts=("$dir" -type f)
    [[ "$RECURSIVE" != true ]] && find_opts+=(-maxdepth 1)

    local find_stderr
    find_stderr="$(mktemp --tmpdir="${TEMP_DIR}" "find_err_XXXXXX")" 2>/dev/null
    while IFS= read -r -d '' file; do
        process_single_file "$file" || true
    done < <(find "${find_opts[@]}" -print0 2>"${find_stderr:-/dev/null}" || true)
    if [[ -n "$find_stderr" && -s "$find_stderr" ]]; then
        while IFS= read -r err; do
            log WARN "find: $err"
        done < "$find_stderr"
    fi
    rm -f "$find_stderr" 2>/dev/null || true
}

# ============================= CLI ===========================================
show_help() {
    cat << EOF
theduckpurge v$VERSION — Secure Metadata Sanitizer

USAGE:
  $SCRIPT_NAME [OPTIONS] [FILES|DIRECTORIES...]

OPTIONS:
  --level LEVEL     Cleaning level (light|standard|aggressive|paranoid)
  -b, --backup      Create backups before cleaning
  -r, --rename      Rename cleaned files
  -R, --recursive   Process directories recursively
  --check-only      Only verify, do not modify files
  --dry-run         Simulate without making changes
  --zero-trace      Traceless mode (quiet + no backups)
  --quiet           Only show errors
  --verbose         Show detailed per-file info
  --force           Ignore size limits
  --no-color        Disable colored output
  --json            Output JSON report (non-interactive use)
  --config FILE     Load config file with defaults
  --exclude GLOB    Exclude files matching pattern (repeatable)
  --jobs N          Accepted for compatibility; runs sequentially
  --report          Detailed metadata report per file (read-only)
  --init            Generate .theduckpurge.exclude in current dir
  -h, --help        Show this help
  -v, --version     Show version

EXAMPLES:
  $SCRIPT_NAME --check-only document.pdf
  $SCRIPT_NAME --level paranoid -R ./my_files/
  $SCRIPT_NAME --backup --rename image.jpg
  $SCRIPT_NAME --exclude '\.log$' --exclude "node_modules" -R ./
  $SCRIPT_NAME --config ~/.config/theduckpurge/config -R ./
  $SCRIPT_NAME --json --check-only ./photos/
  $SCRIPT_NAME --init

No arguments shows this help.

EXIT CODES:
  0  Success (all files processed)
  1  Processing errors occurred
  2  No files were processed
  3  Missing required dependency
  4  Permission error

CONFIG FILE FORMAT (key=value, one per line):
  level=standard
  backup=true
  recursive=true
  jobs=4
  exclude=node_modules
  exclude=.git
EOF
}

parse_arguments() {
    INPUT_PATHS=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --level)
                LEVEL="${2:-}"
                [[ ! "$LEVEL" =~ ^(light|standard|aggressive|paranoid)$ ]] && {
                    log ERROR "Invalid level: $LEVEL"
                    exit 1
                }
                shift 2 ;;
            -b|--backup)      BACKUP=true; shift ;;
            -r|--rename)      RENAME=true; shift ;;
            -R|--recursive)   RECURSIVE=true; shift ;;
            --check-only)     CHECK_ONLY=true; shift ;;
            --dry-run)        DRY_RUN=true; shift ;;
            --zero-trace)     ZERO_TRACE=true; QUIET=true; BACKUP=false; shift ;;
            --quiet)          QUIET=true; shift ;;
            --verbose)        VERBOSE=true; shift ;;
            --force)          FORCE=true; shift ;;
            --no-color)       NO_COLOR=true; shift ;;
            --json)           JSON=true; QUIET=true; shift ;;
            --config)
                [[ -z "${2:-}" ]] && { log ERROR "Config file path required"; exit 3; }
                load_config "$2"; shift 2 ;;
            --exclude)
                [[ -z "${2:-}" ]] && { log ERROR "Exclude pattern required"; exit 3; }
                EXCLUDE_PATTERNS+=("$2"); shift 2 ;;
            --jobs)
                JOBS="${2:-0}"
                [[ ! "$JOBS" =~ ^[0-9]+$ ]] && { log ERROR "Invalid jobs: $JOBS"; exit 1; }
                log WARN "--jobs is accepted but not implemented yet; running sequentially"
                shift 2 ;;
            --init)           INIT_MODE=true; shift ;;
            --report)         REPORT_MODE=true; CHECK_ONLY=true; shift ;;
            -h|--help)        show_help; exit 0 ;;
            -v|--version)     echo "theduckpurge v$VERSION"; exit 0 ;;
            --)               shift; INPUT_PATHS+=("$@"); break ;;
            -*)               log WARN "Unknown option, treating as file: $1"; INPUT_PATHS+=("$1"); shift ;;
            *)                INPUT_PATHS+=("$1"); shift ;;
        esac
    done
}

setup_temp_dir() {
    [[ "$CHECK_ONLY" == true ]] && return 0
    if command_exists mktemp; then
        TEMP_DIR="$(mktemp -d --tmpdir "theduckpurge_XXXXXX")"
    else
        TEMP_DIR="/tmp/theduckpurge_$$_${RANDOM}_$(date +%s%N)"
        mkdir -m 700 "$TEMP_DIR"
    fi
    trap 'rm -rf "$TEMP_DIR" 2>/dev/null || true' EXIT INT TERM
}

setup_backup_dir() {
    [[ "$CHECK_ONLY" == true || "$BACKUP" != true ]] && return 0
    BACKUP_DIR="$(pwd)/theduckpurge_backups/$(date +%Y%m%d_%H%M%S)_$$_${RANDOM}"
    mkdir -p "$BACKUP_DIR" 2>/dev/null || { log WARN "Could not create backup directory"; BACKUP=false; }
}

show_summary() {
    # Machine mode: the summary lives inside json_output; keep stdout pure JSON.
    [[ "$JSON" == true ]] && return 0
    echo
    if [[ "$CHECK_ONLY" == true ]]; then
        printf "Evaluated: %d  |  Clean: %d  |  Dirty: %d  |  Skipped: %d  |  Failed: %d\n" \
            "$TOTAL" "$VERIFIED_CLEAN" "$VERIFIED_DIRTY" "$SKIPPED" "$FAILED"
    elif [[ "$DRY_RUN" == true ]]; then
        printf "Evaluated: %d  |  Simulated: %d  |  Skipped: %d  |  Failed: %d\n" \
            "$TOTAL" "$DRY_COUNT" "$SKIPPED" "$FAILED"
    else
        printf "Evaluated: %d  |  Cleaned: %d  |  Skipped: %d  |  Failed: %d\n" \
            "$TOTAL" "$CLEANED" "$SKIPPED" "$FAILED"
        [[ "$REENCODED" -gt 0 ]] && log INFO "Re-encoded: $REENCODED"
    fi

    if [[ -n "$BACKUP_DIR" ]] && [[ "$BACKUP" == true ]] && [[ $BACKUP_COUNT -gt 0 ]]; then
        echo "Backups: $BACKUP_COUNT file(s) at $BACKUP_DIR"
    fi

    if [[ $FAILED -eq 0 && $TOTAL -gt 0 ]]; then
        if [[ "$CHECK_ONLY" == true ]]; then
            log SUCCESS "Verification completed."
        elif [[ "$DRY_RUN" == true ]]; then
            log INFO "Simulation completed."
        else
            log SUCCESS "Cleanup completed."
        fi
    elif [[ $FAILED -gt 0 ]]; then
        log WARN "Completed with $FAILED error(s)."
    else
        log INFO "No files were processed."
    fi
}

# ============================= INIT MODE =====================================
do_init() {
    local exclude_file=".theduckpurge.exclude"
    if [[ -f "$exclude_file" ]]; then
        log WARN "$exclude_file already exists in $(pwd)"
        return 0
    fi
    cat > "$exclude_file" << 'EXCLUDE'
# theduckpurge exclusion patterns (one per line)
# Files/directories matching these patterns will be skipped
# Supports grep extended regex syntax
#
# Examples:
# node_modules
# \.git$
# \.log$
# __pycache__
# \.env$
EXCLUDE
    log SUCCESS "Created $exclude_file"
}

# ============================= MAIN ==========================================
main() {
    init_colors

    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    parse_arguments "$@"

    if [[ "$INIT_MODE" == true ]]; then
        do_init
        exit 0
    fi

    if [[ ${#INPUT_PATHS[@]} -eq 0 ]]; then
        log ERROR "No files or directories specified"
        exit 2
    fi

    [[ "$ZERO_TRACE" == true ]] && { BACKUP=false; QUIET=true; }
    [[ "$QUIET" != true && "$JSON" != true ]] && echo "theduckpurge v$VERSION — $LEVEL"

    check_dependencies
    build_exclude_pattern
    setup_temp_dir
    setup_backup_dir

    # Pre-count total files for progress indicator (null-delimited for safety)
    BATCH_TOTAL=0
    for p in "${INPUT_PATHS[@]}"; do
        if [[ -f "$p" ]]; then
            (( ++BATCH_TOTAL ))
        elif [[ -d "$p" ]]; then
            local maxdepth=() cnt=0
            [[ "$RECURSIVE" != true ]] && maxdepth=(-maxdepth 1)
            cnt="$(find "$p" -type f "${maxdepth[@]}" -print0 2>/dev/null | tr -d -c '\0' | wc -c)" || true
            BATCH_TOTAL=$(( BATCH_TOTAL + cnt ))
        fi
    done

    for path in "${INPUT_PATHS[@]}"; do
        if [[ -L "$path" ]]; then
            log WARN "Symlink skipped: $path"
            (( ++SKIPPED ))
        elif [[ -f "$path" ]]; then
            # || true: a per-file failure must not trip errexit and abort
            # the whole batch before summary/exit-code logic runs.
            process_single_file "$path" || true
        elif [[ -d "$path" ]]; then
            process_directory "$path"
        else
            log ERROR "Does not exist: $path"
            (( ++FAILED ))
        fi
    done

    show_summary

    if [[ "$JSON" == true ]]; then
        json_output "$TOTAL" "$CLEANED" "$SKIPPED" "$FAILED"
    fi

    if [[ $FAILED -gt 0 ]]; then
        # Exit 4 only when every failure was permission-related; mixed
        # failures keep the generic exit 1.
        if [[ $PERM_ERRORS -eq $FAILED ]]; then
            exit 4
        fi
        exit 1
    elif [[ $TOTAL -eq 0 ]]; then
        exit 2
    else
        exit 0
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
