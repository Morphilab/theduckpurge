# theduckpurge — .gitignore

# Backups created by the tool (setup_backup_dir)
theduckpurge_backups/
*.backup

# Temporary and generated files
*.tmp
*.bak
*~
*.log
*.swp
*.swo
*.temp

# Test scratch directories and Bats helpers (cloned locally, not tracked)
test/tmp*/
test/temp*/
*.bats.tmp
test/test_helper/bats-*
test/test_helper/*-batslib-*

# Python cache (tests invoke python3 for JSON validation)
__pycache__/
*.py[cod]

# Editor and IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Environment and local config
.env
*.env
*.conf.local

# Logs
logs/
